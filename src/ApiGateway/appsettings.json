{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "clinic-route": {
        "ClusterId": "clinic-cluster",
        "Match": { "Path": "/api/clinics/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/clinics/{**catch-all}" }]
      },
      "doctor-route": {
        "ClusterId": "clinic-cluster",
        "Match": { "Path": "/api/doctors/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/doctors/{**catch-all}" }]
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/appointments/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/appointments/{**catch-all}" }]
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": { "Path": "/api/patients/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/patients/{**catch-all}" }]
      }
    },
    "Clusters": {
      "clinic-cluster": {
        "Destinations": {
          "clinic-service": { "Address": "http://clinic-service:8080" }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking-service": { "Address": "http://booking-service:8080" }
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient-service": { "Address": "http://patient-service:8080" }
        }
      }
    }
  }
}
