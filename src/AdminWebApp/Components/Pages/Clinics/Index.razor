@page "/clinics"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Клініки — DentalBooking Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-building me-2 text-primary"></i>Клініки</h4>
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Додати клініку
    </button>
</div>

@if (showForm)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0">Нова клініка</h6>
        </div>
        <div class="card-body">
            <EditForm Model="form" OnValidSubmit="CreateClinic">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Назва *</label>
                        <InputText @bind-Value="form.Name" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Місто *</label>
                        <InputText @bind-Value="form.City" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Телефон *</label>
                        <InputText @bind-Value="form.Phone" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Вулиця *</label>
                        <InputText @bind-Value="form.Street" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Будинок *</label>
                        <InputText @bind-Value="form.BuildingNumber" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Часовий пояс</label>
                        <InputSelect @bind-Value="form.TimeZoneId" class="form-select">
                            <option value="Europe/Kyiv">Europe/Kyiv (UTC+2/3)</option>
                            <option value="Europe/Warsaw">Europe/Warsaw (UTC+1/2)</option>
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Опис</label>
                        <InputTextArea @bind-Value="form.Description" class="form-control" rows="2" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="alert alert-danger mt-3 py-2">@formError</div>
                }
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Зберегти
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showForm = false">Скасувати</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="d-flex justify-content-center my-4"><div class="spinner-border text-primary"></div></div>
}
else if (clinics?.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-building fs-1 d-block mb-2"></i>
        Клінік ще немає
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in clinics!)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title mb-1">@c.Name</h6>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt me-1"></i>@c.City, @c.Street @c.BuildingNumber
                        </p>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-telephone me-1"></i>@c.Phone
                        </p>
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <p class="text-muted small mt-2 mb-0">@c.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-white border-0">
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"/doctors?clinicId={c.Id}")'>
                            <i class="bi bi-person-badge me-1"></i>Лікарі
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ClinicDto>? clinics;
    private bool isLoading = true;
    private bool showForm;
    private bool saving;
    private string? formError;
    private ClinicFormModel form = new();

    protected override async Task OnInitializedAsync()
    {
        try { clinics = await Api.GetClinicsAsync(); }
        finally { isLoading = false; }
    }

    private void ShowCreateForm()
    {
        form = new();
        formError = null;
        showForm = true;
    }

    private async Task CreateClinic()
    {
        saving = true;
        formError = null;
        var (success, error) = await Api.CreateClinicAsync(new CreateClinicRequest(
            form.Name, form.City, form.Street, form.BuildingNumber,
            form.Phone, form.TimeZoneId, form.Description));

        if (success)
        {
            showForm = false;
            clinics = await Api.GetClinicsAsync();
        }
        else
        {
            formError = error ?? "Помилка при збереженні";
        }
        saving = false;
    }

    private sealed class ClinicFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string City { get; set; } = "Київ";
        public string Street { get; set; } = string.Empty;
        public string BuildingNumber { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = "Europe/Kyiv";
        public string? Description { get; set; }
    }
}
